{
  "name": "docent",
  "displayName": "Docent",
  "description": "Plays an editable code tour committed to a branch: the editor scrolls itself, spotlights what is being discussed, and narrates beside it",
  "version": "0.9.0",
  "publisher": "sakhisheikh",
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Education",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "docent.start",
        "title": "Docent: open the tour"
      },
      {
        "command": "docent.play",
        "title": "Docent: play"
      },
      {
        "command": "docent.pause",
        "title": "Docent: pause"
      },
      {
        "command": "docent.next",
        "title": "Docent: next step"
      },
      {
        "command": "docent.prev",
        "title": "Docent: previous step"
      },
      {
        "command": "docent.faster",
        "title": "Docent: faster"
      },
      {
        "command": "docent.slower",
        "title": "Docent: slower"
      },
      {
        "command": "docent.voice",
        "title": "Docent: read stops out loud, on or off"
      }
    ],
    "keybindings": [
      {
        "command": "docent.play",
        "key": "ctrl+alt+space",
        "mac": "ctrl+alt+space",
        "when": "!inputFocus"
      },
      {
        "command": "docent.next",
        "key": "ctrl+alt+]",
        "mac": "ctrl+alt+]"
      },
      {
        "command": "docent.prev",
        "key": "ctrl+alt+[",
        "mac": "ctrl+alt+["
      },
      {
        "command": "docent.faster",
        "key": "ctrl+alt+=",
        "mac": "ctrl+alt+="
      },
      {
        "command": "docent.slower",
        "key": "ctrl+alt+-",
        "mac": "ctrl+alt+-"
      },
      {
        "command": "docent.voice",
        "key": "ctrl+alt+v",
        "mac": "ctrl+alt+v"
      }
    ],
    "configuration": {
      "title": "Docent",
      "properties": {
        "docent.speak": {
          "type": "boolean",
          "default": true,
          "description": "Read each stop's title and narration out loud, so the code can be read while listening. macOS uses say, Linux uses spd-say, and Windows has no voice yet."
        },
        "docent.voice": {
          "type": "string",
          "default": "",
          "description": "Which system voice to use, empty for the default. macOS only; say -v '?' lists them."
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sakhisheikh/docent.git",
    "directory": "editor/vscode"
  },
  "homepage": "https://github.com/sakhisheikh/docent",
  "bugs": {
    "url": "https://github.com/sakhisheikh/docent/issues"
  },
  "keywords": [
    "code-review",
    "walkthrough",
    "code-tour",
    "pull-request",
    "narration"
  ],
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#1e222a",
    "theme": "dark"
  }
}
